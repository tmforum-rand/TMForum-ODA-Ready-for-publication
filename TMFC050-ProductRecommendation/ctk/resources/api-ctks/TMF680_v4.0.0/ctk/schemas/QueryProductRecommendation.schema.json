{
  "$schema": "http://json-schema.org/schema#",
  "type": "object",
  "properties": {
     "href": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "category": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        }
      }
    },
    "productOrderItem": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          }
        },
        "required": ["itemId", "entityId"]
      }
    },
    "shoppingCartItem": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "itemId": {
            "type": "string"
          },
          "entityId": {
            "type": "string"
          }
        },
        "required": ["itemId", "entityId"]
      }
    }
  },
  "anyOf": [
    {
      "required": ["category"]
    },
    {
      "required": ["productOrderItem"]
    },
    {
      "required": ["shoppingCartItem"]
    }
  ]
}